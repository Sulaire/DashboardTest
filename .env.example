# Copia este archivo a .env.local para probar en tu ordenador. En Railway,
# estas mismas variables van en la pestaña Variables del servicio.
# Ninguna lleva valor aquí: los secretos no van en el repo.

# Postgres, con el usuario dueño (el que da Railway al añadir un Postgres).
DATABASE_URL=
# Contraseña larga y aleatoria (24+ caracteres) para panel_app, el usuario
# con el que la app lee los datos. La app se la pone sola al arrancar.
PANEL_DB_PASSWORD=
# Cadena larga y aleatoria para firmar las sesiones (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# La dirección pública de la app. En tu ordenador no hace falta (localhost:3000).
PANEL_URL=
# Tu correo: el único administrador.
PANEL_ADMIN_EMAIL=
# Para mandar los correos de entrada. Sin ellos, en tu ordenador el enlace sale en la terminal.
RESEND_API_KEY=
PANEL_CORREO_DE=
